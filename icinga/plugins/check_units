#!/bin/bash
# check_units - CRITICAL if any of the given systemd units is not active
# Usage: check_units unit [unit ...]
# Also warns about any failed unit on the system. No root needed.
(( $# )) || { echo "UNKNOWN - no units given"; exit 3; }
down=()
for u in "$@"; do
  systemctl is-active --quiet "$u" || down+=("$u=$(systemctl is-active "$u")")
done
mapfile -t failed < <(systemctl list-units --state=failed --plain --no-legend 2>/dev/null | awk '{print $1}')

if (( ${#down[@]} )); then
  echo "CRITICAL - not active: ${down[*]}${failed:+; failed: ${failed[*]}} | down=${#down[@]} failed=${#failed[@]}"; exit 2
elif (( ${#failed[@]} )); then
  echo "WARNING - $# units active; failed units: ${failed[*]} | down=0 failed=${#failed[@]}"; exit 1
fi
echo "OK - $# units active: $* | down=0 failed=0"
exit 0
